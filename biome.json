{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": ["**", "!dist", "!.claude"]
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "semicolons": "always",
      "trailingCommas": "es5",
      "quoteStyle": "single",
      "lineEnding": "lf",
      "lineWidth": 120,
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120,
      "lineEnding": "lf"
    }
  },
  "linter": {
    "enabled": true,
    "includes": ["!test"]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
